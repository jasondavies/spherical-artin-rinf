/-
# Type H₃: the Franzsen–Howlett route (paper v3, Lemma 4.1) — no `hOut`

Generated by scripts/gen_fh.py.  Every reflection-preserving automorphism of `ρ(W)` is conjugation by an
element of `ρ(W)` or `ρ(W)π₀`: kernel-checked search-tree certificate
(`Data/H3Tree.lean`, produced by `scripts/export_tree.py`).
-/
import ArtinRinf.FH
import ArtinRinf.Types.H3
import ArtinRinf.Data.H3Tree

set_option maxHeartbeats 0

namespace ArtinRinf.H3

open H3Tree ArtinGroup

noncomputable section

theorem rp_invol : ∀ t x, rpFun t (rpFun t x) = x := by decide +kernel

/-- The reflection permutations `ρ(t)`, `t ∈ T`. -/
def rp (t : Fin 15) : Equiv.Perm (Fin 15) := ⟨rpFun t, rpFun t, rp_invol t, rp_invol t⟩

theorem rp_sidx : ∀ i, rp (D.sidx i) = D.gens i := by decide +kernel
theorem rp_equiv : ∀ i t, D.gens i * rp t * D.gens i = rp (D.gens i t) := by decide +kernel
theorem rp_inj : ∀ a b, rp a = rp b → a = b := by decide +kernel

/-- Reflection permutations of `H₃`. -/
def R : D.RpData := ⟨rp, rp_sidx, rp_equiv, rp_inj⟩

theorem pi0_ok : ∀ t, pi0 * rp t * pi0⁻¹ = rp (pi0 t) := by decide +kernel

theorem tree_ext_ok : ∀ q c, (node q).length < 3 → ReflData.validExt R.rp M (node q) c = true →
    node (child q c) = node q ++ [repF q c] ∧
      (node q).all (fun p => decide (D.wordPerm (hw q c) p = p)) = true ∧
      D.wordPerm (hw q c) (repF q c) = c := by
  decide +kernel

theorem tree_leaf_ok : ∀ q, (node q).length = 3 → ∀ i : Fin 3,
    (node q)[i.val]? = some ((D.wordPerm (leafW q) * (if leafE q then pi0 else 1)) (D.sidx i)) := by
  decide +kernel

/-- The search-tree certificate for `H₃`. -/
def TC : D.TreeCert R pi0 where
  K := K
  node := node
  root := root
  root_ok := by decide +kernel
  child := child
  repF := repF
  hw := hw
  ext_ok := tree_ext_ok
  leafW := leafW
  leafE := leafE
  leaf_ok := tree_leaf_ok
  pi0_ok := pi0_ok

theorem gens_isOrd : ∀ i j : Fin 3, i.val < j.val → isOrdB (D.gens i * D.gens j) (M i j) = true := by
  decide +kernel

/-- **Main theorem for `H₃`, Franzsen–Howlett version.**  Hypotheses: only the cited theorems
`hW` (`W` finite), `hCP` (Cohen–Paris), `hBr` (Brieskorn, `H₁(P) ≅ ℤ^15`) and `hFH`
(Franzsen–Howlett, [FH03, Thm. 31]: `Aut(W) = R(W)·A(W)`). -/
theorem artin_H3_R_infty_FH (hW : Finite M.Group) (hCP : (pure M).Characteristic)
    (hBr : Nonempty (Abelianization (pure M) ≃* Multiplicative (Fin 15 → ℤ)))
    (hFH : FranzsenHowlett M) :
    ∀ φ : ArtinGroup M ≃* ArtinGroup M, reidemeisterAut φ = ⊤ :=
  D.rinf_FH R pi0 TC gens_isOrd hW hCP hBr hFH witness_inner witness_outer

end

end ArtinRinf.H3
