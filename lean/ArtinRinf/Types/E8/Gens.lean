import ArtinRinf.Certificate
import ArtinRinf.Data.E8

set_option maxHeartbeats 0

namespace ArtinRinf.E8

open E8Data ArtinGroup Matrix

noncomputable section

/-- The Coxeter matrix `E₈` (Mathlib's). -/
abbrev M : CoxeterMatrix (Fin 8) := CoxeterMatrix.E₈

theorem gensFun_invol : ∀ i x, gensFun i (gensFun i x) = x := by decide +kernel

/-- The permutation of the 120 reflections induced by `s_i`. -/
def gens (i : Fin 8) : Equiv.Perm (Fin 120) :=
  ⟨gensFun i, gensFun i, gensFun_invol i, gensFun_invol i⟩

theorem gens_sq : ∀ i, gens i * gens i = 1 := by decide +kernel
theorem gens_fix : ∀ i, gens i (sidx i) = sidx i := by decide +kernel
/-- Lemma 2.4 for `E₈`: the braid relations hold in `ℤ^T ⋊ Perm T`. -/
theorem braid_ok : ∀ i j, i ≠ j → braidWord (affGen ℤ gens sidx i) (affGen ℤ gens sidx j) (M i j) =
    braidWord (affGen ℤ gens sidx j) (affGen ℤ gens sidx i) (M i j) := by decide +kernel
theorem cox2_ok : ∀ i j,
    (affGen (ZMod 2) gens sidx i * affGen (ZMod 2) gens sidx j) ^ (M i j) = 1 := by
  decide +kernel
theorem orb_ok : ∀ t, ((orbWord t).1.map gens).prod (sidx (orbWord t).2) = t := by
  decide +kernel

/-- The reflection data of `E₈`. -/
def D : ReflData M (Fin 120) where
  gens := gens
  sidx := sidx
  gens_sq := gens_sq
  gens_fix := gens_fix
  braid := braid_ok
  cox2 := cox2_ok
  orbWord := orbWord
  orb := orb_ok


end

end ArtinRinf.E8
