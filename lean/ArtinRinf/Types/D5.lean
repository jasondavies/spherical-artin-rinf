/-
# Type D₅: the finite certificates, checked by `decide +kernel`, and the final theorem

Generated by scripts/gen_types.py.
-/
import ArtinRinf.Certificate
import ArtinRinf.CoxD5
import ArtinRinf.Data.D5

set_option maxHeartbeats 0

namespace ArtinRinf.D5

open D5Data ArtinGroup Matrix

noncomputable section

/-- The Coxeter matrix `D₅` (defined in `CoxD5.lean`). -/
abbrev M : CoxeterMatrix (Fin 5) := ArtinRinf.D₅

theorem gensFun_invol : ∀ i x, gensFun i (gensFun i x) = x := by decide +kernel

/-- The permutation of the 20 reflections induced by `s_i`. -/
def gens (i : Fin 5) : Equiv.Perm (Fin 20) :=
  ⟨gensFun i, gensFun i, gensFun_invol i, gensFun_invol i⟩

theorem gens_sq : ∀ i, gens i * gens i = 1 := by decide +kernel
theorem gens_fix : ∀ i, gens i (sidx i) = sidx i := by decide +kernel
/-- Lemma 2.3 for `D₅`: the braid relations hold in `ℤ^T ⋊ Perm T`. -/
theorem braid_ok : ∀ i j, i ≠ j → braidWord (affGen ℤ gens sidx i) (affGen ℤ gens sidx j) (M i j) =
    braidWord (affGen ℤ gens sidx j) (affGen ℤ gens sidx i) (M i j) := by decide +kernel
theorem cox2_ok : ∀ i j,
    (affGen (ZMod 2) gens sidx i * affGen (ZMod 2) gens sidx j) ^ (M i j) = 1 := by
  decide +kernel
theorem orb_ok : ∀ t, ((orbWord t).1.map gens).prod (sidx (orbWord t).2) = t := by
  decide +kernel

/-- The reflection data of `D₅`. -/
def D : ReflData M (Fin 20) where
  gens := gens
  sidx := sidx
  gens_sq := gens_sq
  gens_fix := gens_fix
  braid := braid_ok
  cox2 := cox2_ok
  orbWord := orbWord
  orb := orb_ok

theorem ok_none : ∀ r s, par r s = none → rep (lab r s) = (r, s) := by decide +kernel
theorem ok_some : ∀ r s i, par r s = some i →
    lab (gens i r) (gens i s) = lab r s ∧ depth (gens i r) (gens i s) < depth r s := by
  decide +kernel

/-- The orbital certificate. -/
def C : OrbitalCert gens 4 where
  lab := lab
  rep := rep
  par := par
  depth := depth
  ok_none := ok_none
  ok_some := ok_some

theorem orbital_scalar : ∀ ω j, orbMat lab ω *ᵥ U0 j = mu0 ω • U0 j := by decide +kernel

/-- **Good constituent** (dimension 10): every matrix commuting with `ρ(W)` acts on it by a
scalar. -/
theorem commScalar_U0 : CommScalar D.ρ (spanZ U0) :=
  commScalar_of_cert D.ρ gens D.hgen C U0 mu0 orbital_scalar

/-- Witnesses for the trivial outer class (`π = 1`). -/
theorem witness_inner : Witness D.ρ 1 :=
  Or.inl ⟨_, commScalar_U0, D.stableWitness 1 U0 [] [innerMinusGen] innerPlusC innerMinusC
    (by decide +kernel) (by decide +kernel) (by decide +kernel) (by decide +kernel)⟩

/-- **Main theorem for `D₅`.**  Assuming
* `hW`: `W(D₅)` is finite (classical);
* `hCP`: the pure Artin group is characteristic (Cohen–Paris, Thm 1.4; computer-assisted);
* `hBr`: `H₁(P;ℤ) ≅ ℤ^20` (Brieskorn; Orlik–Terao; 20 = number of reflections);
* `hOut`: every automorphism of `ρ(W) ≅ W/Z(W)` is inner (computed, `code/indep/out_check.py`; also Franzsen–Howlett Thm 31(3)),
every automorphism of `A(D₅)` has infinite Reidemeister number. -/
theorem artin_D5_R_infty (hW : Finite M.Group) (hCP : (pure M).Characteristic)
    (hBr : Nonempty (Abelianization (pure M) ≃* Multiplicative (Fin 20 → ℤ)))
    (hOut : OutGeneratedBy D.ρ.range 1) :
    ∀ φ : ArtinGroup M ≃* ArtinGroup M, reidemeisterAut φ = ⊤ :=
  D.rinf hW hCP hBr 1 hOut witness_inner witness_inner

end

end ArtinRinf.D5
