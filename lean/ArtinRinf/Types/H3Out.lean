/-
# Type H₃: `Out(ρ(W))` verified in Lean by enumeration

This removes the hypothesis `hOut` from the `H₃` theorem: the remaining hypotheses are exactly the
cited theorems (finiteness of `W`, Cohen–Paris, Brieskorn).
-/
import ArtinRinf.OutCert
import ArtinRinf.Types.H3
import ArtinRinf.Data.H3Out

set_option maxHeartbeats 0

namespace ArtinRinf.H3

open H3Out ArtinGroup

noncomputable section

theorem elt_inv1 : ∀ k x, eltInvFun k (eltFun k x) = x := by decide +kernel
theorem elt_inv2 : ∀ k x, eltFun k (eltInvFun k x) = x := by decide +kernel

/-- The 60 elements of `ρ(W(H₃)) ≅ A₅`. -/
def elt (k : Fin 60) : Equiv.Perm (Fin 15) := ⟨eltFun k, eltInvFun k, elt_inv1 k, elt_inv2 k⟩

theorem word_ok : ∀ k, elt k = ((word k).map D.gens).prod := by decide +kernel
theorem one_ok : elt 0 = 1 := by decide +kernel
theorem mul_ok : ∀ i k, D.gens i * elt k = elt (mulTab i k) := by decide +kernel
theorem inv_ok : ∀ k, elt k * elt k = 1 → elt k ≠ 1 → k ∈ invIdx := by decide +kernel
theorem gens_ne : ∀ i j : Fin 3, i ≠ j → D.gens i ≠ D.gens j := by decide +kernel
theorem gens_ne_one : ∀ i : Fin 3, D.gens i ≠ 1 := by decide +kernel
theorem gens_rel : ∀ i j, (D.gens i * D.gens j) ^ (M i j) = 1 := by decide +kernel
theorem M_lt' : ∀ i j : Fin 3, Nat.blt (M i j) 6 = true := by decide +kernel
theorem M_lt (i j : Fin 3) : M i j < 6 := Nat.blt_eq.mp (M_lt' i j)
theorem gens_ord' : ∀ i j : Fin 3, ∀ d : Fin 6, 0 < d.val → d.val < M i j →
    (D.gens i * D.gens j) ^ d.val ≠ 1 := by
  decide +kernel
theorem gens_ord (i j : Fin 3) (d : ℕ) (hd : 0 < d) (hdm : d < M i j) :
    (D.gens i * D.gens j) ^ d ≠ 1 :=
  gens_ord' i j ⟨d, lt_trans hdm (M_lt i j)⟩ hd hdm

/-- The conjugator `c = elt k` or `elt k * π₀`. -/
def cand (k : Fin 60) (b : Bool) : Equiv.Perm (Fin 15) := if b then elt k * pi0 else elt k

/-- The core finite check (with pruning and a table of conjugators): every triple of distinct
involutions satisfying the Coxeter relations of `H₃` is conjugate to `(ρ(s₀), ρ(s₁), ρ(s₂))` by an
element of `ρ(W)` or `ρ(W)π₀`. -/
theorem check_concrete : ∀ k0 ∈ invIdx, ∀ k1 ∈ invIdx, elt k0 ≠ elt k1 →
    (elt k0 * elt k1) ^ (M 0 1) = 1 → ∀ k2 ∈ invIdx, elt k0 ≠ elt k2 → elt k1 ≠ elt k2 →
    (elt k0 * elt k2) ^ (M 0 2) = 1 → (elt k1 * elt k2) ^ (M 1 2) = 1 →
    ∃ e ∈ conjTable, e.1 = k0 ∧ e.2.1 = k1 ∧ e.2.2.1 = k2 ∧
      cand e.2.2.2.1 e.2.2.2.2 * D.gens 0 * (cand e.2.2.2.1 e.2.2.2.2)⁻¹ = elt k0 ∧
      cand e.2.2.2.1 e.2.2.2.2 * D.gens 1 * (cand e.2.2.2.1 e.2.2.2.2)⁻¹ = elt k1 ∧
      cand e.2.2.2.1 e.2.2.2.2 * D.gens 2 * (cand e.2.2.2.1 e.2.2.2.2)⁻¹ = elt k2 := by
  decide +kernel

/-- The enumeration certificate for `Out(ρ(W(H₃)))`. -/
def outCert : ReflData.OutCert D pi0 60 where
  elt := elt
  word := word
  word_ok := word_ok
  one_idx := 0
  one_ok := one_ok
  mulTab := mulTab
  mul_ok := mul_ok
  invIdx := invIdx
  inv_ok := inv_ok
  gens_ne := gens_ne
  gens_ne_one := gens_ne_one
  gens_rel := gens_rel
  gens_ord := gens_ord
  check := by
    intro y hy hd hr _
    obtain ⟨e, -, -, -, -, h0, h1, h2⟩ := check_concrete (y 0) (hy 0) (y 1) (hy 1)
      (hd 0 1 (by decide)) (hr 0 1) (y 2) (hy 2) (hd 0 2 (by decide)) (hd 1 2 (by decide))
      (hr 0 2) (hr 1 2)
    refine ⟨e.2.2.2.1, e.2.2.2.2, ?_⟩
    intro i
    fin_cases i
    · exact h0
    · exact h1
    · exact h2

/-- `|Out(ρ(W(H₃)))| ≤ 2`, generated by `π₀` — verified in Lean (paper, Proposition 4.1(b)). -/
theorem hOut : OutGeneratedBy D.ρ.range pi0 := outCert.outGeneratedBy

/-- **Main theorem for `H₃`, with `Out(W/Z)` verified in Lean.**  The only hypotheses are the
cited theorems: `W(H₃)` finite, Cohen–Paris (`P` characteristic), Brieskorn (`H₁(P) ≅ ℤ^15`). -/
theorem artin_H3_R_infty' (hW : Finite M.Group) (hCP : (pure M).Characteristic)
    (hBr : Nonempty (Abelianization (pure M) ≃* Multiplicative (Fin 15 → ℤ))) :
    ∀ φ : ArtinGroup M ≃* ArtinGroup M, reidemeisterAut φ = ⊤ :=
  artin_H3_R_infty hW hCP hBr hOut

end

end ArtinRinf.H3
