/- Identify the parity extension with the group generated by the affine Artin images. -/
import ArtinRinf.Dihedral5.Count

open DihedralGroup
namespace ArtinRinf.Dihedral5

theorem perm_injective : Function.Injective perm := by
  have h : ∀ g h : Hol, (∀ i, perm g i = perm h i) → g = h := by decide +kernel
  intro g k heq
  exact h g k (fun i => congrArg (fun p : Equiv.Perm I => p i) heq)

/-- A faithful realization inside the integral affine permutation group. -/
def affineMap : Gamma →* Aff ℤ I where
  toFun x := ⟨x.val.v, perm x.val.g⟩
  map_one' := Aff.ext rfl perm_one
  map_mul' x y := Aff.ext rfl (perm_mul x.val.g y.val.g)

theorem affineMap_injective : Function.Injective affineMap := by
  intro x y h
  apply Subtype.ext
  apply Ambient.ext
  · exact congrArg Aff.v h
  · exact perm_injective (congrArg Aff.σ h)

def a : Gamma := element (sr 0) 0
def b : Gamma := element (sr 3) 0

theorem generator_vectors : a.val.v = Pi.single 0 1 ∧ b.val.v = Pi.single 1 1 := by
  decide +kernel

theorem braid_relation : a * b * a * b * a = b * a * b * a * b := by
  apply Subtype.ext
  apply Ambient.ext <;> decide +kernel

def generated : Subgroup Gamma := Subgroup.closure {a, b}

lemma a_mem : a ∈ generated := Subgroup.subset_closure (by simp)
lemma b_mem : b ∈ generated := Subgroup.subset_closure (by simp)

def rotation : Gamma := (b * a)^3

lemma rotation_mem : rotation ∈ generated := generated.pow_mem (generated.mul_mem b_mem a_mem) 3

theorem basis_translation : ∀ i : I,
    rotation^i.val * a^2 * (rotation^i.val)⁻¹ = translation (Pi.single i 1) := by
  intro i
  apply Subtype.ext
  apply Ambient.ext
  · revert i; decide +kernel
  · revert i; decide +kernel

lemma translation_add (x y : V) : translation (x + y) = translation x * translation y := by
  apply Subtype.ext
  apply Ambient.ext
  · simp [translation_v, perm_one, smul_add]
  · simp

lemma translation_zero : translation 0 = 1 := by
  apply Subtype.ext
  ext <;> simp

def translationHom : Multiplicative V →* Gamma where
  toFun x := translation x.toAdd
  map_one' := translation_zero
  map_mul' x y := translation_add x.toAdd y.toAdd

lemma translation_zsmul (n : ℤ) (x : V) : translation (n • x) = (translation x)^n :=
  translationHom.map_zpow (Multiplicative.ofAdd x) n

lemma translation_mem (x : V) : translation x ∈ generated := by
  have hb (i : I) : translation ((x i) • Pi.single i 1) ∈ generated := by
    rw [translation_zsmul, ← basis_translation]
    exact generated.zpow_mem
      (generated.mul_mem (generated.mul_mem (generated.pow_mem rotation_mem _)
        (generated.pow_mem a_mem _)) (generated.inv_mem (generated.pow_mem rotation_mem _))) _
  have hs (s : Finset I) : translation (∑ i ∈ s, (x i) • Pi.single i 1) ∈ generated := by
    induction s using Finset.induction_on with
    | empty => simp [translation_zero]
    | @insert i s hi ih =>
      rw [Finset.sum_insert hi, translation_add]
      exact generated.mul_mem (hb i) ih
  convert hs Finset.univ using 1
  congr 1
  ext i
  simp [Pi.single_apply]

def sectionWord (g : Hol) : Gamma :=
  match g with
  | r k => rotation^k.val
  | sr k => a * rotation^k.val

theorem sectionWord_g : ∀ g, (sectionWord g).val.g = g := by decide +kernel

lemma sectionWord_mem (g : Hol) : sectionWord g ∈ generated := by
  cases g with
  | r k => exact generated.pow_mem rotation_mem _
  | sr k => exact generated.mul_mem a_mem (generated.pow_mem rotation_mem _)

lemma translation_element (g : Hol) (x y : V) :
    translation x * element g y = element g (x + y) := by
  apply Subtype.ext
  apply Ambient.ext
  · simp only [Subgroup.coe_mul, Ambient.mul_v, translation_v, translation_g,
      element_v, perm_one, pact_one]
    module
  · simp

/-- The parity extension is exactly the group generated by the two affine images. -/
theorem generated_eq_top : generated = ⊤ := by
  apply top_unique
  intro x _
  have hw := sectionWord_mem x.val.g
  rw [← element_coordinates (sectionWord x.val.g), sectionWord_g] at hw
  have ht := generated.mul_mem
    (translation_mem (coordinates x - coordinates (sectionWord x.val.g))) hw
  rw [translation_element, sub_add_cancel, element_coordinates] at ht
  exact ht

/-- Transfer to a group identified with this concrete affine extension.
The identification with the presented Artin quotient is an explicit input. -/
theorem exists_reidemeister_eighteen {Q : Type*} [Group Q] (e : Q ≃* Gamma) :
    ∃ ψ : Q ≃* Q, reidemeisterAut ψ = 18 := by
  let ψ := (e.trans phi).trans e.symm
  refine ⟨ψ, ?_⟩
  calc reidemeisterAut ψ = reidemeisterAut phi :=
      reidemeister_eq_of_mulEquiv ψ.toMonoidHom phi.toMonoidHom e (by
        intro x
        simp [ψ])
    _ = 18 := reidemeister_phi

end ArtinRinf.Dihedral5
