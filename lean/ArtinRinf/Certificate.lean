/-
# Finite certificates (paper, Lemma 2.12(i) and the witnesses of Proposition 4.4)

* `OrbitalCert`: a labelling of `T × T` together with a spanning forest showing that each label
  class lies in a single orbit of the group generated by `gens`.  Every matrix commuting with the
  `gens` is then constant on label classes, i.e. a combination of the "orbital" 0/1 matrices.
* If every orbital matrix maps each basis vector `b j` of `U` to `μ ω • b j`, then every matrix
  commuting with `ρ(A)` acts on `U` as a scalar (`CommScalar`).
* Integer data for the eigenvalue witnesses.
-/
import ArtinRinf.Criterion
import ArtinRinf.Pure

open Function Matrix

namespace ArtinRinf

variable {A : Type*} [Group A] {B : Type*} [Fintype B] {T : Type*} [Fintype T] [DecidableEq T]

/-- A certificate that the label classes of `lab : T → T → Fin k` are contained in orbits of the
group generated by `gens` acting diagonally on `T × T`: each pair either is the representative of
its label, or has a parent `(gens i r, gens i s)` with the same label and smaller depth. -/
structure OrbitalCert (gens : B → Equiv.Perm T) (k : ℕ) where
  lab : T → T → Fin k
  rep : Fin k → T × T
  par : T → T → Option B
  depth : T → T → ℕ
  ok_none : ∀ r s, par r s = none → rep (lab r s) = (r, s)
  ok_some : ∀ r s i, par r s = some i →
    lab (gens i r) (gens i s) = lab r s ∧ depth (gens i r) (gens i s) < depth r s

/-- The orbital matrix of label `ω`. -/
def orbMat {k : ℕ} (lab : T → T → Fin k) (ω : Fin k) : Matrix T T ℤ :=
  Matrix.of fun r s => if lab r s = ω then 1 else 0

namespace OrbitalCert

variable {gens : B → Equiv.Perm T} {k : ℕ} (C : OrbitalCert gens k)

/-- An invariant function on `T × T` is constant on label classes. -/
lemma const {N : T → T → ℚ} (hN : ∀ i r s, N (gens i r) (gens i s) = N r s) :
    ∀ r s, N r s = N (C.rep (C.lab r s)).1 (C.rep (C.lab r s)).2 := by
  suffices h : ∀ n, ∀ r s, C.depth r s = n →
      N r s = N (C.rep (C.lab r s)).1 (C.rep (C.lab r s)).2 from
    fun r s => h _ r s rfl
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro r s hrs
    cases hp : C.par r s with
    | none => rw [C.ok_none r s hp]
    | some i =>
      obtain ⟨hl, hd⟩ := C.ok_some r s i hp
      rw [← hN i r s, ih _ (hrs ▸ hd) _ _ rfl, hl]

end OrbitalCert

/-- Commuting with a permutation matrix means invariance under the diagonal action. -/
lemma entry_invariant_of_comm (N : Matrix T T ℚ) (σ : Equiv.Perm T)
    (h : N * pmat ℚ σ = pmat ℚ σ * N) (r s : T) : N (σ r) (σ s) = N r s := by
  have := congrFun (congrFun h (σ r)) s
  simp only [Matrix.mul_apply, pmat, of_apply, mul_ite, mul_one, mul_zero, ite_mul, one_mul,
    zero_mul] at this
  rw [Finset.sum_ite_eq' Finset.univ (σ s), if_pos (Finset.mem_univ _)] at this
  rw [this]
  have e : ∀ j, (σ r = σ j) ↔ (j = r) := fun j => by
    rw [σ.injective.eq_iff, eq_comm]
  simp_rw [e]
  simp

/-- The rational span of integer vectors. -/
def spanZ {d : ℕ} (b : Fin d → T → ℤ) : Submodule ℚ (T → ℚ) :=
  Submodule.span ℚ (Set.range fun j => fun t => (b j t : ℚ))

/-- **Lemma 2.12(i), certificate form.**  If the label classes are orbits-closed (certificate `C`)
and every orbital matrix acts on the integer basis `b` of `U` by scalars `μ ω`, then every rational
matrix commuting with `ρ(A)` acts on `U` as a scalar. -/
theorem commScalar_of_cert (ρ : A →* Equiv.Perm T) (gens : B → Equiv.Perm T)
    (hgen : ∀ i, ∃ a, ρ a = gens i) {k : ℕ} (C : OrbitalCert gens k) {d : ℕ}
    (b : Fin d → T → ℤ) (μ : Fin k → ℤ)
    (hμ : ∀ ω j, orbMat C.lab ω *ᵥ b j = μ ω • b j) : CommScalar ρ (spanZ b) := by
  intro N hN
  have hinv : ∀ i r s, N (gens i r) (gens i s) = N r s := by
    intro i r s
    obtain ⟨a, ha⟩ := hgen i
    rw [← ha]
    exact entry_invariant_of_comm N (ρ a) (hN a) r s
  have hconst := C.const hinv
  set c : ℚ := ∑ ω, N (C.rep ω).1 (C.rep ω).2 * (μ ω : ℚ) with hc
  -- the basis vectors
  have hb : ∀ j, N *ᵥ (fun t => (b j t : ℚ)) = c • (fun t => (b j t : ℚ)) := by
    intro j
    funext r
    have hrow : ∀ ω, (∑ s, (if C.lab r s = ω then (b j s : ℚ) else 0)) = (μ ω : ℚ) * b j r := by
      intro ω
      have := congrFun (hμ ω j) r
      simp only [mulVec, dotProduct, orbMat, of_apply, ite_mul, one_mul, zero_mul,
        Pi.smul_apply, smul_eq_mul] at this
      exact_mod_cast this
    simp only [mulVec, dotProduct, Pi.smul_apply, smul_eq_mul]
    calc ∑ s, N r s * (b j s : ℚ)
        = ∑ s, ∑ ω, (if C.lab r s = ω then N (C.rep ω).1 (C.rep ω).2 * (b j s : ℚ) else 0) := by
          refine Finset.sum_congr rfl (fun s _ => ?_)
          rw [Finset.sum_ite_eq Finset.univ (C.lab r s), if_pos (Finset.mem_univ _), hconst r s]
      _ = ∑ ω, N (C.rep ω).1 (C.rep ω).2 * ∑ s, (if C.lab r s = ω then (b j s : ℚ) else 0) := by
          rw [Finset.sum_comm]
          refine Finset.sum_congr rfl (fun ω _ => ?_)
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl (fun s _ => ?_)
          split_ifs <;> simp
      _ = c * (b j r : ℚ) := by
          rw [hc, Finset.sum_mul]
          refine Finset.sum_congr rfl (fun ω _ => ?_)
          rw [hrow]; ring
  refine ⟨c, fun u hu => ?_⟩
  induction hu using Submodule.span_induction with
  | mem x hx =>
    obtain ⟨j, rfl⟩ := hx
    exact hb j
  | zero => simp
  | add x y _ _ hx hy => rw [mulVec_add, hx, hy, smul_add]
  | smul a x _ hx => rw [mulVec_smul, hx, smul_comm]

/-! ### Witnesses from integer data -/

/-- The integer combination `∑ c j • b j`. -/
def combo {d : ℕ} (b : Fin d → T → ℤ) (c : Fin d → ℤ) : T → ℤ := ∑ j, c j • b j

lemma cast_combo_mem {d : ℕ} (b : Fin d → T → ℤ) (c : Fin d → ℤ) :
    (fun t => (combo b c t : ℚ)) ∈ spanZ b := by
  have : (fun t => (combo b c t : ℚ)) = ∑ j, (c j : ℚ) • (fun t => (b j t : ℚ)) := by
    funext t
    simp [combo, Finset.sum_apply]
  rw [this]
  exact Submodule.sum_mem _ (fun j _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨j, rfl⟩))

lemma pmat_cast (σ : Equiv.Perm T) (x : T → ℤ) :
    pmat ℚ σ *ᵥ (fun t => (x t : ℚ)) = fun t => ((pact σ x t : ℤ) : ℚ) := by
  rw [pmat_mulVec]; rfl

lemma cast_ne_zero_of_ne_zero {x : T → ℤ} (hx : x ≠ 0) : (fun t => (x t : ℚ)) ≠ 0 := by
  intro h
  apply hx
  funext t
  have := congrFun h t
  simpa using this

/-- One stable witness from integer data: `h π x = ε x` with `h = ρ a`. -/
lemma stable_one {d : ℕ} (ρ : A →* Equiv.Perm T) (π : Equiv.Perm T) (b : Fin d → T → ℤ)
    (ε : ℤ) (a : A) (c : Fin d → ℤ) (h0 : combo b c ≠ 0)
    (heq : pact (ρ a * π) (combo b c) = ε • combo b c) :
    ∃ a : A, ∃ v ∈ spanZ b, v ≠ 0 ∧ pmat ℚ (ρ a * π) *ᵥ v = (ε : ℚ) • v := by
  refine ⟨a, _, cast_combo_mem b c, cast_ne_zero_of_ne_zero h0, ?_⟩
  rw [pmat_cast, heq]
  funext t; simp

/-- A stable witness for `π` from integer data for `ε = 1` and `ε = -1`. -/
lemma stableWitness_of_int {d : ℕ} (ρ : A →* Equiv.Perm T) (π : Equiv.Perm T)
    (b : Fin d → T → ℤ) (a₁ a₂ : A) (c₁ c₂ : Fin d → ℤ)
    (h₁0 : combo b c₁ ≠ 0) (h₁ : pact (ρ a₁ * π) (combo b c₁) = combo b c₁)
    (h₂0 : combo b c₂ ≠ 0) (h₂ : pact (ρ a₂ * π) (combo b c₂) = -combo b c₂) :
    StableWitness ρ (spanZ b) π := by
  rintro ε (rfl | rfl)
  · obtain ⟨a, v, hv, hv0, h⟩ := stable_one ρ π b 1 a₁ c₁ h₁0 (by rw [h₁, one_smul])
    exact ⟨a, v, hv, hv0, by simpa using h⟩
  · obtain ⟨a, v, hv, hv0, h⟩ := stable_one ρ π b (-1) a₂ c₂ h₂0 (by rw [h₂, neg_one_smul])
    exact ⟨a, v, hv, hv0, by simpa using h⟩

/-- One swap witness from integer data. -/
lemma swap_one {d₁ d₂ : ℕ} (ρ : A →* Equiv.Perm T) (π : Equiv.Perm T)
    (b₁ : Fin d₁ → T → ℤ) (b₂ : Fin d₂ → T → ℤ) (ε : ℤ) (a : A)
    (c : Fin d₁ → ℤ) (c' : Fin d₂ → ℤ) (h0 : combo b₁ c ≠ 0)
    (hU₂ : pact (ρ a * π) (combo b₁ c) = combo b₂ c')
    (hsq : pact (ρ a * π) (pact (ρ a * π) (combo b₁ c)) = ε • combo b₁ c)
    (hne1 : pact (ρ a * π) (combo b₁ c) ≠ combo b₁ c)
    (hne2 : pact (ρ a * π) (combo b₁ c) ≠ -combo b₁ c) :
    ∃ a : A, ∃ v ∈ spanZ b₁, v ≠ 0 ∧ pmat ℚ (ρ a * π) *ᵥ v ∈ spanZ b₂ ∧
      pmat ℚ (ρ a * π) *ᵥ (pmat ℚ (ρ a * π) *ᵥ v) = (ε : ℚ) • v ∧
      pmat ℚ (ρ a * π) *ᵥ v ≠ v ∧ pmat ℚ (ρ a * π) *ᵥ v ≠ -v := by
  refine ⟨a, _, cast_combo_mem b₁ c, cast_ne_zero_of_ne_zero h0, ?_, ?_, ?_, ?_⟩
  · rw [pmat_cast, hU₂]; exact cast_combo_mem b₂ c'
  · rw [pmat_cast, pmat_cast, hsq]; funext t; simp
  · rw [pmat_cast]
    intro h; apply hne1; funext t
    have := congrFun h t; simpa using this
  · rw [pmat_cast]
    intro h; apply hne2; funext t
    have := congrFun h t; simp only [Pi.neg_apply] at this; simp only [Pi.neg_apply]
    exact_mod_cast this

namespace ReflData

variable {B : Type*} [DecidableEq B] {M : CoxeterMatrix B} {T : Type*} [Fintype T] [DecidableEq T]
  (D : ReflData M T)

open ArtinGroup

/-- The generators of `ρ(A)`. -/
lemma hgen (i : B) : ∃ a, D.ρ a = D.gens i := ⟨σ M i, D.ρ_σ i⟩

/-- Stable witnesses from words and integer coefficient vectors. -/
lemma stableWitness {d : ℕ} (π : Equiv.Perm T) (b : Fin d → T → ℤ) (w₁ w₂ : List B)
    (c₁ c₂ : Fin d → ℤ)
    (h₁0 : combo b c₁ ≠ 0) (h₁ : pact ((w₁.map D.gens).prod * π) (combo b c₁) = combo b c₁)
    (h₂0 : combo b c₂ ≠ 0) (h₂ : pact ((w₂.map D.gens).prod * π) (combo b c₂) = -combo b c₂) :
    StableWitness D.ρ (spanZ b) π :=
  stableWitness_of_int D.ρ π b ((w₁.map (σ M)).prod) ((w₂.map (σ M)).prod) c₁ c₂
    h₁0 (by rw [D.ρ_list_prod]; exact h₁) h₂0 (by rw [D.ρ_list_prod]; exact h₂)

/-- Swap witnesses from words and integer coefficient vectors. -/
lemma swapWitness {d₁ d₂ : ℕ} (π : Equiv.Perm T) (b₁ : Fin d₁ → T → ℤ) (b₂ : Fin d₂ → T → ℤ)
    (w₁ w₂ : List B) (c₁ c₂ : Fin d₁ → ℤ) (c₁' c₂' : Fin d₂ → ℤ)
    (h₁ : let Q := (w₁.map D.gens).prod * π; let x := combo b₁ c₁
      x ≠ 0 ∧ pact Q x = combo b₂ c₁' ∧ pact Q (pact Q x) = x ∧ pact Q x ≠ x ∧ pact Q x ≠ -x)
    (h₂ : let Q := (w₂.map D.gens).prod * π; let x := combo b₁ c₂
      x ≠ 0 ∧ pact Q x = combo b₂ c₂' ∧ pact Q (pact Q x) = -x ∧ pact Q x ≠ x ∧ pact Q x ≠ -x) :
    SwapWitness D.ρ (spanZ b₁) (spanZ b₂) π := by
  rintro ε (rfl | rfl)
  · obtain ⟨h0, hU, hsq, hn1, hn2⟩ := h₁
    rw [← D.ρ_list_prod] at hU hsq hn1 hn2
    obtain ⟨a, v, hv, hv0, h⟩ := swap_one D.ρ π b₁ b₂ 1 _ c₁ c₁' h0 hU (by rw [hsq, one_smul])
      hn1 hn2
    exact ⟨a, v, hv, hv0, by simpa using h⟩
  · obtain ⟨h0, hU, hsq, hn1, hn2⟩ := h₂
    rw [← D.ρ_list_prod] at hU hsq hn1 hn2
    obtain ⟨a, v, hv, hv0, h⟩ := swap_one D.ρ π b₁ b₂ (-1) _ c₂ c₂' h0 hU
      (by rw [hsq, neg_one_smul]) hn1 hn2
    exact ⟨a, v, hv, hv0, by simpa using h⟩

end ReflData

end ArtinRinf
