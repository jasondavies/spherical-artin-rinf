/-
# Verifying `Out(ρ(W))` by enumeration (used for `H₃`)

Given an explicit list of the elements of `ρ(W) ≤ Perm T` (with a multiplication-by-generator
table proving closure) and a check that every "Coxeter-like" tuple of involutions is conjugate to
the generators by an element of `ρ(W)` or of `ρ(W)π₀`, we prove `OutGeneratedBy ρ(W) π₀`.
-/
import ArtinRinf.Certificate

open Function

namespace ArtinRinf

namespace ReflData

variable {B : Type*} [DecidableEq B] {M : CoxeterMatrix B} {T : Type*} [Fintype T] [DecidableEq T]
  (D : ReflData M T)

open ArtinGroup

/-- `ρ(A)` is the subgroup generated by the generator permutations. -/
lemma range_eq_closure : D.ρ.range = Subgroup.closure (Set.range D.gens) := by
  have h : (⊤ : Subgroup (ArtinGroup M)) = Subgroup.closure (Set.range (σ M)) :=
    (PresentedGroup.closure_range_of _).symm
  rw [MonoidHom.range_eq_map, h, MonoidHom.map_closure]
  congr 1
  ext x
  constructor
  · rintro ⟨_, ⟨i, rfl⟩, rfl⟩; exact ⟨i, (D.ρ_σ i).symm⟩
  · rintro ⟨i, rfl⟩; exact ⟨_, ⟨i, rfl⟩, D.ρ_σ i⟩

/-- Induction over `ρ(A)` by left multiplication with generators. -/
lemma range_induction {p : Equiv.Perm T → Prop} (one : p 1)
    (step : ∀ i y, y ∈ D.ρ.range → p y → p (D.gens i * y)) {x : Equiv.Perm T}
    (hx : x ∈ D.ρ.range) : p x := by
  have hinv : ∀ i, (D.gens i)⁻¹ = D.gens i := fun i =>
    inv_eq_of_mul_eq_one_right (D.gens_sq i)
  rw [range_eq_closure] at hx
  induction hx using Subgroup.closure_induction_left with
  | one => exact one
  | mul_left x hx y hy ih =>
    obtain ⟨i, rfl⟩ := hx
    exact step i y (by rw [range_eq_closure]; exact hy) ih
  | inv_mul_cancel x hx y hy ih =>
    obtain ⟨i, rfl⟩ := hx
    rw [hinv]
    exact step i y (by rw [range_eq_closure]; exact hy) ih

/-- An explicit enumeration of `ρ(W)` together with the check for `Out`. -/
structure OutCert (π₀ : Equiv.Perm T) (K : ℕ) where
  elt : Fin K → Equiv.Perm T
  /-- each listed element lies in `ρ(W)` (a word for it) -/
  word : Fin K → List B
  word_ok : ∀ k, elt k = ((word k).map D.gens).prod
  one_idx : Fin K
  one_ok : elt one_idx = 1
  /-- closure under left multiplication by generators -/
  mulTab : B → Fin K → Fin K
  mul_ok : ∀ i k, D.gens i * elt k = elt (mulTab i k)
  /-- the involutions -/
  invIdx : List (Fin K)
  inv_ok : ∀ k, elt k * elt k = 1 → elt k ≠ 1 → k ∈ invIdx
  gens_ne : ∀ i j, i ≠ j → D.gens i ≠ D.gens j
  gens_ne_one : ∀ i, D.gens i ≠ 1
  gens_rel : ∀ i j, (D.gens i * D.gens j) ^ (M i j) = 1
  gens_ord : ∀ i j d, 0 < d → d < M i j → (D.gens i * D.gens j) ^ d ≠ 1
  /-- every Coxeter-like tuple of involutions is conjugate to the generators by `ρ(W) ∪ ρ(W)π₀` -/
  check : ∀ y : B → Fin K, (∀ i, y i ∈ invIdx) → (∀ i j, i ≠ j → elt (y i) ≠ elt (y j)) →
    (∀ i j, (elt (y i) * elt (y j)) ^ (M i j) = 1) →
    (∀ i j d, 0 < d → d < M i j → (elt (y i) * elt (y j)) ^ d ≠ 1) →
    ∃ k : Fin K, ∃ b : Bool, ∀ i,
      (if b then elt k * π₀ else elt k) * D.gens i * (if b then elt k * π₀ else elt k)⁻¹ =
        elt (y i)

variable {D}

lemma OutCert.elt_mem {π₀ : Equiv.Perm T} {K : ℕ} (C : OutCert D π₀ K) (k : Fin K) :
    C.elt k ∈ D.ρ.range :=
  ⟨((C.word k).map (σ M)).prod, by rw [D.ρ_list_prod, C.word_ok]⟩

lemma OutCert.mem_elt {π₀ : Equiv.Perm T} {K : ℕ} (C : OutCert D π₀ K) {x : Equiv.Perm T}
    (hx : x ∈ D.ρ.range) : ∃ k, x = C.elt k := by
  refine D.range_induction (p := fun x => ∃ k, x = C.elt k) ⟨C.one_idx, C.one_ok.symm⟩ ?_ hx
  rintro i y _ ⟨k, rfl⟩
  exact ⟨C.mulTab i k, C.mul_ok i k⟩

/-- **`Out(ρ(W))` from an enumeration certificate.** -/
theorem OutCert.outGeneratedBy {π₀ : Equiv.Perm T} {K : ℕ} (C : OutCert D π₀ K) :
    OutGeneratedBy D.ρ.range π₀ := by
  intro θ
  have hg : ∀ i, D.gens i ∈ D.ρ.range := fun i => ⟨σ M i, D.ρ_σ i⟩
  let g : B → D.ρ.range := fun i => ⟨D.gens i, hg i⟩
  choose y hy using fun i => C.mem_elt (θ (g i)).2
  -- properties of the images of the generators
  have hinv : ∀ i, y i ∈ C.invIdx := by
    intro i
    apply C.inv_ok
    · rw [← hy i]
      have : θ (g i) * θ (g i) = 1 := by
        rw [← map_mul]
        have : g i * g i = 1 := Subtype.ext (D.gens_sq i)
        rw [this, map_one]
      exact congrArg Subtype.val this
    · rw [← hy i]
      intro h
      have : θ (g i) = θ 1 := by rw [map_one]; exact Subtype.ext h
      exact C.gens_ne_one i (congrArg Subtype.val (θ.injective this))
  have hdist : ∀ i j, i ≠ j → C.elt (y i) ≠ C.elt (y j) := by
    intro i j hij h
    rw [← hy i, ← hy j] at h
    exact C.gens_ne i j hij (congrArg Subtype.val (θ.injective (Subtype.ext h)))
  have hrel : ∀ i j, (C.elt (y i) * C.elt (y j)) ^ (M i j) = 1 := by
    intro i j
    rw [← hy i, ← hy j]
    have : (θ (g i) * θ (g j)) ^ (M i j) = 1 := by
      rw [← map_mul, ← map_pow]
      have : (g i * g j) ^ (M i j) = 1 := Subtype.ext (by simpa using C.gens_rel i j)
      rw [this, map_one]
    exact congrArg Subtype.val this
  have hord : ∀ i j d, 0 < d → d < M i j → (C.elt (y i) * C.elt (y j)) ^ d ≠ 1 := by
    intro i j d hd hdm h
    rw [← hy i, ← hy j] at h
    have h' : θ ((g i * g j) ^ d) = θ 1 := by
      rw [map_pow, map_mul, map_one]; exact Subtype.ext h
    have := congrArg Subtype.val (θ.injective h')
    simp only [SubgroupClass.coe_pow, Subgroup.coe_mul, OneMemClass.coe_one] at this
    exact C.gens_ord i j d hd hdm this
  obtain ⟨k, b, hk⟩ := C.check y hinv hdist hrel hord
  set c := if b then C.elt k * π₀ else C.elt k with hc
  -- `θ` agrees with conjugation by `c` on all of `ρ(W)`
  have hθ : ∀ x : D.ρ.range, (θ x : Equiv.Perm T) = c * x * c⁻¹ := by
    rintro ⟨x, hx⟩
    refine D.range_induction
      (p := fun x => ∀ hx : x ∈ D.ρ.range, (θ ⟨x, hx⟩ : Equiv.Perm T) = c * x * c⁻¹)
      ?_ ?_ hx hx
    · intro h1
      have : (⟨1, h1⟩ : D.ρ.range) = 1 := rfl
      rw [this, map_one]; simp
    · intro i z hz ih hiz
      have : (⟨D.gens i * z, hiz⟩ : D.ρ.range) = g i * ⟨z, hz⟩ := rfl
      rw [this, map_mul, Subgroup.coe_mul, ih hz, hy i, ← hk i]
      group
  refine ⟨C.elt k, C.elt_mem k, ?_⟩
  cases b
  · exact Or.inl hθ
  · exact Or.inr hθ

end ReflData

end ArtinRinf
